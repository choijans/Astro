# Backend
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/astro
REDIS_URL=redis://localhost:6379
QUEUE_NAME=commands
REDIS_DB=0
WORKER_CONCURRENCY=5
COMMAND_JOB_ATTEMPTS=6
COMMAND_JOB_BACKOFF_MS=1000
RATE_LIMIT_MAX=60
RATE_LIMIT_TTL_MS=60000
# How long the worker caches Astro's channel list for REFRESH_CHANNEL, in milliseconds
ASTRO_LIST_CACHE_TTL_MS=60000
# Redis response cache for GET /channels and GET /channels/:id; set to false to disable entirely
CACHE_ENABLED=true
# How long a cached channel list page is served before it's re-fetched, in seconds
CACHE_LIST_TTL_SECONDS=30
# How long a cached channel detail response is served before it's re-fetched, in seconds
CACHE_DETAIL_TTL_SECONDS=60
PORT=3001
CORS_ORIGIN=http://localhost:3000
ASTRO_API_URL=https://contenthub-api.eco.astro.com.my/api/v2/search-linear

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
